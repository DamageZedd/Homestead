local function deliver_toolkit(kit_section, tier)
    local actor_alao = db.actor
    if not actor_alao then return end
    -- Try both naming conventions (toolkit_N and itm_basickit/advancedkit/expertkit)
    local alt_names = {
        ["toolkit_1"] = "itm_basickit",
        ["toolkit_2"] = "itm_advancedkit",
        ["toolkit_3"] = "itm_expertkit",
    }
    local itm = actor_alao:object(kit_section) or (alt_names[kit_section] and actor_alao:object(alt_names[kit_section]))
    if not itm then return end

    alife_release(alife_object(itm:id()))

    local hub_id, camp = stalker_camp_builder.get_active_camp_near(actor_alao:position())
    if camp then
        camp.tech_toolkit_tier = math.max(camp.tech_toolkit_tier or 0, tier)
        camp.morale = math.min(100, (camp.morale or 50) + 10)
    end

    local tier_names = { [1] = "Basic", [2] = "Advanced", [3] = "Expert" }
    news_manager.send_tip(actor_alao, string.format(game.translate_string("st_tech_toolkit_delivered"), tier), nil, "general_stalker", 8000)
end

function stalker_camp_builder.give_tech_toolkit1(actor, npc) deliver_toolkit("toolkit_1", 1) end
function stalker_camp_builder.give_tech_toolkit2(actor, npc) deliver_toolkit("toolkit_2", 2) end
function stalker_camp_builder.give_tech_toolkit3(actor, npc) deliver_toolkit("toolkit_3", 3) end


        <!-- 30: Actor selects: Deliver Basic Tools -->
        <phrase id="30">
            <precondition>stalker_camp_builder.actor_has_toolkit1</precondition>
            <text>st_camp_tech_tools1_ask</text>
            <action>stalker_camp_builder.give_tech_toolkit1</action>
            <next>33</next>
        </phrase>

        <!-- 31: Actor selects: Deliver Advanced Tools -->
        <phrase id="31">
            <precondition>stalker_camp_builder.actor_has_toolkit2</precondition>
            <text>st_camp_tech_tools2_ask</text>
            <action>stalker_camp_builder.give_tech_toolkit2</action>
            <next>33</next>
        </phrase>

        <!-- 32: Actor selects: Deliver Expert Tools -->
        <phrase id="32">
            <precondition>stalker_camp_builder.actor_has_toolkit3</precondition>
            <text>st_camp_tech_tools3_ask</text>
            <action>stalker_camp_builder.give_tech_toolkit3</action>
            <next>33</next>
        </phrase>

        <!-- 33: NPC replies after toolkit delivery -->
        <phrase id="33">
            <text>st_camp_tech_tools_done</text>
            <action>dialogs.break_dialog</action>
        </phrase>

        <!-- 99: Actor selects: "Never mind." -->
        <phrase id="99">
            <text>st_manage_camp_close</text>
            <next>100</next>
        </phrase>

        <!-- 100: NPC replies on goodbye -->
        <phrase id="100">
            <text>st_manage_camp_close_reply</text>
            <action>dialogs.break_dialog</action>
        </phrase>
    </phrase_list>
</dialog>
]]


<!-- ======================================================================
    Homestead (Stalker Settlement Builder)
    Mapspot Definitions for Settlement Hubs and Dynamic Outposts
========================================================================== -->

<!-- 1. Player Settlement Camp Hub -->
<homestead_camp_hub>
    <level_map spot="homestead_camp_hub_spot"/>
    <mini_map spot="homestead_camp_hub_mini_spot"/>
</homestead_camp_hub>

<homestead_camp_hub_spot width="44" height="44" alignment="c" stretch="1" scale="1" scale_min="1.0" scale_max="1.5" location_level="5">
    <texture r="80" g="240" b="140">ui_pda2_base</texture>
</homestead_camp_hub_spot>

<homestead_camp_hub_mini_spot width="21" height="21" alignment="c" stretch="1" scale="1" scale_min="1.0" scale_max="1.5" location_level="5">
    <texture r="80" g="240" b="140">ui_mmap_base</texture>
</homestead_camp_hub_mini_spot>


